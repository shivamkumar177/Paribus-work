# App
APP_NAME="Paribus API"
APP_VERSION="0.1.0"
APP_DESCRIPTION="FastAPI boilerplate for Paribus assignment"
DEBUG=False
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# API
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=["*"]

# Hospital Directory API
HOSPITAL_API_BASE_URL=https://hospital-directory.onrender.com
HOSPITAL_API_TIMEOUT=30
HOSPITAL_API_CONCURRENCY=5
HOSPITAL_API_MAX_RETRIES=2
BULK_MAX_HOSPITALS=20

# DB (to be configured later)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/paribus_db
